---
import "../styles.css";
import Header from "@/components/site/Header.astro";
import Footer from "@/components/site/Footer.astro";
import AdSlot from "@/components/site/AdSlot.astro";
import { adsConfig } from "@/data/ads";
import { analyticsConfig, siteVerification } from "@/data/analytics";
import { breadcrumbLd, faqLd, graphLd, pageTitle, type Crumb, type FaqItem } from "@/lib/seo-doc";
import { absUrl, OG_IMAGE, SITE_NAME, SITE_URL } from "@/lib/site";
import type { LangLink } from "@/components/site/Header.astro";
import { hasTranslation, LANG_META, LANGS, localePath, t, translateProxyUrl, type Lang } from "@/i18n/ui";

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  /** Canonical path when this page duplicates another (defaults to `path`). */
  canonical?: string;
  ogType?: "website" | "article";
  published?: string;
  updated?: string;
  crumbs?: Crumb[];
  faqs?: FaqItem[];
  extraJsonLd?: Record<string, unknown>[];
  /** Override the share image. `imageAlt` is required whenever `image` is set. */
  image?: { path: string; alt: string; width: number; height: number; type?: string };
  /** Page language. Translated pages pass "kn" or "hi" and a /kn or /hi path. */
  lang?: Lang;
}

const {
  title,
  description,
  path,
  noindex = false,
  canonical,
  ogType = "website",
  published,
  updated,
  crumbs = [],
  faqs = [],
  extraJsonLd = [],
  image: shareImage = OG_IMAGE,
  lang = "en",
} = Astro.props;

// Language versions: English path is the base; /kn and /hi mirror it when translated.
const basePath = lang === "en" ? path : path.replace(new RegExp(`^/${lang}(?=/|$)`), "") || "/";
const translated = hasTranslation(basePath);
const meta = LANG_META[lang];
const alternates = translated
  ? LANGS.map((l) => ({ lang: l, href: absUrl(localePath(l, basePath)) }))
  : [{ lang: "en" as Lang, href: absUrl(basePath) }];
const langLinks: LangLink[] = LANGS.map((l) =>
  translated || l === "en"
    ? { lang: l, href: localePath(l, basePath), external: false }
    : { lang: l, href: translateProxyUrl(l, basePath), external: true },
);

const fullTitle = pageTitle(title);
const url = absUrl(canonical ?? path);
const image = absUrl(shareImage.path);
const imageType = shareImage.type ?? "image/jpeg";
const nodes: Record<string, unknown>[] = [];
nodes.push({
  "@type": "WebPage",
  "@id": `${url}#webpage`,
  url,
  name: fullTitle,
  description,
  inLanguage: meta.htmlLang,
  isPartOf: { "@id": `${SITE_URL}/#website` },
  about: { "@id": `${SITE_URL}/#organization` },
  primaryImageOfPage: {
    "@type": "ImageObject",
    url: image,
    width: shareImage.width,
    height: shareImage.height,
    caption: shareImage.alt,
  },
  ...(published ? { datePublished: published } : {}),
  ...(updated ? { dateModified: updated } : {}),
  speakable: { "@type": "SpeakableSpecification", cssSelector: [".aio-answer", "h1"] },
});
if (crumbs.length) nodes.push(breadcrumbLd([{ label: t(lang).home, href: localePath(lang, "/") }, ...crumbs]));
if (faqs.length) nodes.push(faqLd(faqs));
nodes.push(...extraJsonLd);
const jsonLd = graphLd(nodes);
const clientId = adsConfig.clientId;
const adsOn = adsConfig.enabled && (Boolean(clientId) || adsConfig.showPlaceholders);
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"} />
    <meta name="author" content={SITE_NAME} />
    <meta name="application-name" content={SITE_NAME} />
    <meta name="theme-color" content="#2563EB" />
    <meta name="language" content={meta.label === "English" ? "English" : lang === "kn" ? "Kannada" : "Hindi"} />
    {alternates.map((a) => <link rel="alternate" hreflang={LANG_META[a.lang].hreflang.toLowerCase()} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={absUrl(basePath)} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:secure_url" content={image} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:width" content={String(shareImage.width)} />
    <meta property="og:image:height" content={String(shareImage.height)} />
    <meta property="og:image:alt" content={shareImage.alt} />
    <meta property="og:locale" content={meta.ogLocale} />
    {alternates.filter((a) => a.lang !== lang).map((a) => <meta property="og:locale:alternate" content={LANG_META[a.lang].ogLocale} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={shareImage.alt} />
    {published ? <meta property="article:published_time" content={published} /> : null}
    {updated ? <meta property="article:modified_time" content={updated} /> : null}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {siteVerification.google ? <meta name="google-site-verification" content={siteVerification.google} /> : null}
    {siteVerification.bing ? <meta name="msvalidate.01" content={siteVerification.bing} /> : null}
    {siteVerification.yandex ? <meta name="yandex-verification" content={siteVerification.yandex} /> : null}
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    {analyticsConfig.ga4MeasurementId.startsWith("GTM-") ? (
      <>
        {/* Google Tag Manager container. The gtm.start / gtm.js event is what GTM's
            "All Pages" trigger listens for, so it must be pushed before gtm.js loads. */}
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
          function gtag() { dataLayer.push(arguments); }
          gtag("js", new Date());
        </script>
        <script async is:inline src={`https://www.googletagmanager.com/gtm.js?id=${analyticsConfig.ga4MeasurementId}`}></script>
      </>
    ) : analyticsConfig.ga4MeasurementId ? (
      <>
        <script async is:inline src={`https://www.googletagmanager.com/gtag/js?id=${analyticsConfig.ga4MeasurementId}`}></script>
        <script is:inline define:vars={{ gaId: analyticsConfig.ga4MeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag("js", new Date());
          gtag("config", gaId, { anonymize_ip: true });
        </script>
      </>
    ) : null}
    {analyticsConfig.cloudflareToken ? (
      <script defer is:inline src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: analyticsConfig.cloudflareToken })}></script>
    ) : null}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("vtuhub-theme");
          if (t === "dark" || (t !== "light" && matchMedia("(prefers-color-scheme: dark)").matches))
            document.documentElement.classList.add("dark");
        } catch (e) {}
      })();
    </script>
    {clientId ? (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${clientId}`} crossorigin="anonymous"></script>
    ) : null}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen bg-background font-sans text-foreground antialiased">
    <a href="#main" class="skip-link">Skip to content</a>
    <Header lang={lang} langLinks={langLinks} />
    {adsOn ? (
      <div class="border-b bg-background">
        <div class="mx-auto w-full max-w-[1200px] px-4 py-3 sm:px-5 md:px-6 lg:px-8">
          <AdSlot format="banner" class="hidden md:flex" />
          <AdSlot format="mobile" class="flex md:hidden" />
        </div>
      </div>
    ) : null}
    <div class:list={["mx-auto grid w-full max-w-[1200px] gap-8 px-4 sm:px-5 md:px-6 lg:px-8", adsOn && "lg:grid-cols-[minmax(0,1fr)_300px]"]}>
      <main id="main" class="min-w-0 py-8 md:py-12">
        <slot />
        <AdSlot format="in-article" class="mt-10" />
      </main>
      {adsOn ? (
        <aside class="hidden lg:block">
          <div class="sticky top-20 space-y-4 py-12">
            <AdSlot format="sidebar" />
          </div>
        </aside>
      ) : null}
    </div>
    <Footer lang={lang} />
    <script is:inline>
      var themeBtn = document.getElementById("theme-toggle");
      if (themeBtn) {
        var label = function (dark) {
          themeBtn.setAttribute("aria-label", dark ? "Switch to light mode" : "Switch to dark mode");
        };
        label(document.documentElement.classList.contains("dark"));
        themeBtn.addEventListener("click", function () {
          var dark = document.documentElement.classList.toggle("dark");
          label(dark);
          try { localStorage.setItem("vtuhub-theme", dark ? "dark" : "light"); } catch (e) {}
        });
      }
    </script>
    <script>
      import "@/scripts/select-search";
    </script>
  </body>
</html>
