---
import { mainNav } from "@/data/nav";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
function active(href: string) {
  return path === href || (href !== "/" && path.startsWith(`${href}/`));
}
---

<header class="sticky top-0 z-50 border-b bg-background">
  <div class="mx-auto flex h-16 w-full max-w-[1200px] items-center gap-3 px-4 sm:px-5 md:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-2.5 text-foreground no-underline" aria-label="VTUHub home">
      <span class="relative grid size-8 place-items-center rounded-md bg-primary" aria-hidden="true">
        <span class="absolute left-1.5 top-1.5 h-4 w-3 rounded-[2px] bg-primary-foreground/50"></span>
        <span class="absolute left-2.5 top-2.5 h-4 w-3 rounded-[2px] bg-primary-foreground"></span>
      </span>
      <span class="font-semibold tracking-tight">VTU<span class="text-primary">Hub</span></span>
    </a>
    <nav aria-label="Primary" class="ml-4 hidden items-center gap-0.5 lg:flex">
      {mainNav.map((item) => (
        <a
          href={item.href}
          class:list={[
            "rounded-sm px-3 py-2 text-sm font-medium",
            active(item.href) ? "text-foreground" : "text-muted hover:text-foreground",
          ]}
          aria-current={active(item.href) ? "page" : undefined}
        >{item.label}</a>
      ))}
    </nav>
    <form action="/search" method="get" role="search" class="ml-auto hidden md:block">
      <label class="sr-only" for="header-q">Search VTUHub</label>
      <input
        id="header-q"
        name="q"
        type="search"
        placeholder="Subject, code, tool"
        class="h-10 w-56 rounded-sm border bg-surface px-3 text-sm"
      />
    </form>
    <div class="ml-auto flex items-center gap-1 md:ml-1">
      <a href="/search" class="inline-flex size-11 items-center justify-center rounded-sm hover:bg-secondary md:hidden" aria-label="Search">Search</a>
      <button type="button" id="theme-toggle" class="inline-flex size-11 items-center justify-center rounded-sm hover:bg-secondary" aria-label="Toggle color theme">Theme</button>
      <details class="nav-details relative lg:hidden">
        <summary class="inline-flex h-11 cursor-pointer items-center rounded-sm px-3 text-sm font-medium hover:bg-secondary">Menu</summary>
        <nav class="absolute right-0 z-50 mt-2 w-64 rounded-lg border bg-background p-2 shadow-sm" aria-label="Mobile">
          <a class="flex h-11 items-center border-b px-2 font-medium" href="/">Home</a>
          {mainNav.map((item) => (
            <a class="flex h-11 items-center border-b px-2 font-medium" href={item.href}>{item.label}</a>
          ))}
          <a class="flex h-11 items-center border-b px-2 font-medium" href="/search">Search</a>
          <a class="flex h-11 items-center border-b px-2 font-medium" href="/faq">FAQ</a>
          <a class="flex h-11 items-center border-b px-2 font-medium" href="/schemes">Schemes</a>
          <a class="flex h-11 items-center px-2 font-medium text-muted" href="/about">About</a>
        </nav>
      </details>
    </div>
  </div>
</header>
