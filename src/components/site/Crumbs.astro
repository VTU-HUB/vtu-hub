---
import type { Crumb } from "@/lib/seo-doc";
interface Props { items: Crumb[] }
const { items } = Astro.props;
const all = [{ label: "Home", href: "/" }, ...items];
---

<nav aria-label="Breadcrumb" class="mb-4 text-sm text-muted">
  <ol class="flex flex-wrap items-center gap-1">
    {all.map((item, i) => (
      <li class="flex items-center gap-1">
        {i > 0 ? <span aria-hidden="true" class="text-faint">/</span> : null}
        {item.href && i < all.length - 1 ? (
          <a class="hover:text-foreground" href={item.href}>{item.label}</a>
        ) : (
          <span class="text-foreground">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
