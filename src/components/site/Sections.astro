---
import type { ArticleSection } from "@/data/types";
import Notice from "@/components/site/Notice.astro";

interface Props { sections: ArticleSection[] }
const { sections } = Astro.props;
---

<div class="max-w-3xl space-y-10">
  {sections.map((sec) => (
    <section>
      <h2 class="text-xl font-semibold">{sec.heading}</h2>
      {sec.paragraphs?.map((p) => <p class="mt-3 leading-relaxed text-muted">{p}</p>)}
      {sec.bullets ? (
        <ul class="mt-3 list-disc space-y-1.5 pl-5 text-muted">
          {sec.bullets.map((b) => <li>{b}</li>)}
        </ul>
      ) : null}
      {sec.table ? (
        <div class="mt-4 overflow-x-auto">
          {sec.table.caption ? <p class="mb-2 text-xs font-medium uppercase tracking-wider text-faint">{sec.table.caption}</p> : null}
          <table class="w-full min-w-[32rem] border-collapse text-sm">
            <thead>
              <tr class="border-b text-left text-xs uppercase tracking-wider text-faint">
                {sec.table.headers.map((h) => <th class="px-3 py-2 font-medium">{h}</th>)}
              </tr>
            </thead>
            <tbody>
              {sec.table.rows.map((row) => (
                <tr class="border-b">
                  {row.map((cell) => <td class="px-3 py-2.5 text-muted">{cell}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : null}
      {sec.note ? <Notice class="mt-4">{sec.note}</Notice> : null}
    </section>
  ))}
</div>
