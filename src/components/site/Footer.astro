---
import { footerInfo, footerResources } from "@/data/nav";
const year = new Date().getFullYear();
---

<footer class="mt-8 border-t bg-background">
  <div class="mx-auto grid w-full max-w-[1200px] gap-10 px-4 py-10 sm:px-5 md:grid-cols-[1.2fr_1fr_1fr] md:px-6 lg:px-8">
    <div>
      <a href="/" class="font-semibold tracking-tight">VTU<span class="text-primary">Hub</span></a>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-muted">
        Independent study platform for Visvesvaraya Technological University students across Karnataka. Based on the Belagavi university. Not an official VTU site.
      </p>
    </div>
    <div>
      <p class="text-xs font-medium uppercase tracking-wider text-faint">Resources</p>
      <ul class="mt-3 space-y-2">
        {footerResources.map((l) => (
          <li><a class="text-sm text-muted hover:text-foreground" href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <p class="text-xs font-medium uppercase tracking-wider text-faint">Information</p>
      <ul class="mt-3 space-y-2">
        {footerInfo.map((l) => (
          <li><a class="text-sm text-muted hover:text-foreground" href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
  <div class="border-t">
    <div class="mx-auto flex w-full max-w-[1200px] flex-wrap items-center justify-between gap-2 px-4 py-4 text-xs text-faint sm:px-5 md:px-6 lg:px-8">
      <p>© {year} VTUHub · Belagavi, Karnataka, India</p>
      <p><a class="hover:text-foreground" href="/llms.txt">llms.txt</a> · <a class="hover:text-foreground" href="/sitemap-index.xml">XML sitemap</a></p>
    </div>
  </div>
</footer>
