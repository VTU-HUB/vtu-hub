---
import { hasTranslation, localePath, t, type Lang } from "@/i18n/ui";
import { TOOL_TEXT } from "@/i18n/content";
import { tools } from "@/data/tools";
import { DISCUSSIONS_URL, GITHUB_URL } from "@/lib/site";

interface Props {
  lang?: Lang;
}
const { lang = "en" } = Astro.props;
const d = t(lang);
const L = d.footer.links;
const loc = (path: string) => (hasTranslation(path) ? localePath(lang, path) : path);
const year = new Date().getFullYear();

const study = [
  { label: L.byBranch, href: loc("/vtu") },
  { label: L.important, href: "/resources/important-questions" },
  { label: L.syllabus, href: "/resources/syllabus" },
  { label: L.lab, href: "/resources/lab-manuals" },
  { label: L.updates, href: "/updates" },
  { label: L.guides, href: "/articles" },
];
const calculators = tools.map((tool) => ({
  label: lang === "en" ? tool.name : TOOL_TEXT[lang][tool.slug]?.name ?? tool.name,
  href: loc(tool.href),
}));
const about = [
  { label: L.aboutUs, href: "/about" },
  { label: L.coverage, href: "/coverage" },
  { label: L.contact, href: "/contact" },
  { label: L.faq, href: loc("/faq") },
  { label: L.privacy, href: "/privacy-policy" },
  { label: L.terms, href: "/terms" },
  { label: L.disclaimer, href: "/disclaimer" },
];
const columns = [
  { title: d.footer.study, links: study },
  { title: d.nav.calculators[0], links: calculators },
  { title: d.footer.about, links: about },
];
---

<footer class="mt-12 border-t bg-secondary/40">
  <div class="mx-auto grid w-full max-w-[1200px] grid-cols-2 gap-x-6 gap-y-8 px-4 py-10 sm:px-5 md:grid-cols-[1.3fr_1fr_1fr_1fr] md:gap-10 md:py-12 md:px-6 lg:px-8">
    <div class="col-span-2 md:col-span-1">
      <a href={localePath(lang, "/")} class="inline-flex items-center gap-2 text-lg font-semibold tracking-tight">
        <span class="relative grid size-7 place-items-center rounded-md bg-primary" aria-hidden="true">
          <span class="absolute left-1.5 top-1.5 h-3.5 w-2.5 rounded-[2px] bg-primary-foreground/50"></span>
          <span class="absolute left-2.5 top-2.5 h-3.5 w-2.5 rounded-[2px] bg-primary-foreground"></span>
        </span>
        <span>VTU<span class="text-primary">Hub</span></span>
      </a>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-muted">
        {d.footer.blurb}
        <a class="text-primary hover:underline" href="https://vtu.ac.in">vtu.ac.in</a>.
      </p>
    </div>
    {columns.map((col, i) => (
      <div class:list={[i === columns.length - 1 && "col-span-2 md:col-span-1"]}>
        <p class="text-xs font-semibold uppercase tracking-wider text-foreground md:text-sm md:normal-case md:tracking-normal">{col.title}</p>
        <ul class:list={["mt-2 md:mt-3 md:space-y-1", i === columns.length - 1 && "grid grid-cols-2 gap-x-6 md:block"]}>
          {col.links.map((l) => (
            <li>
              <a class="flex min-h-10 items-center text-sm text-muted hover:text-primary md:inline-flex md:min-h-0 md:py-1" href={l.href}>{l.label}</a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="border-t">
    <div class="mx-auto flex w-full max-w-[1200px] flex-col items-center gap-1.5 px-4 py-5 text-center text-xs text-faint sm:px-5 md:flex-row md:justify-between md:py-4 md:text-left md:px-6 lg:px-8">
      <p>© {year} VTUHub · Belagavi, Karnataka, India</p>
      <p>
        <a class="hover:text-foreground" href="/contribute">{L.contribute}</a> ·
        <a class="hover:text-foreground" href={GITHUB_URL} rel="noopener" target="_blank">GitHub</a> ·
        <a class="hover:text-foreground" href={DISCUSSIONS_URL} rel="noopener" target="_blank">{L.discussions}</a> ·
        <a class="hover:text-foreground" href="/sitemap">{L.sitemap}</a> · <a class="hover:text-foreground" href="/llms.txt">llms.txt</a>
      </p>
    </div>
  </div>
</footer>
