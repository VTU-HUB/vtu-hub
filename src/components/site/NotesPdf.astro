---
import type { NotesInput } from "@/lib/notes-doc";

interface Props {
  notes: NotesInput;
  label?: string;
  variant?: "primary" | "border";
}

const { notes, label = "Download notes PDF", variant = "primary" } = Astro.props;
const json = JSON.stringify(notes).replace(/</g, "\\u003c");
const cls =
  variant === "primary"
    ? "inline-flex h-11 items-center gap-2 rounded-lg bg-primary px-4 text-sm font-semibold text-primary-foreground hover:bg-primary-hover disabled:opacity-60"
    : "inline-flex h-11 items-center gap-2 rounded-lg border bg-surface px-4 text-sm font-semibold hover:border-primary hover:text-primary disabled:opacity-60";
---

<div data-notes-pdf-root class="inline-flex">
  <button type="button" class={cls} data-download-notes data-label={label}>{label}</button>
  <script type="application/json" data-notes-pdf set:html={json} />
</div>
<script>
  import { mountNotesDownload } from "@/scripts/download-notes.ts";
  mountNotesDownload();
</script>
