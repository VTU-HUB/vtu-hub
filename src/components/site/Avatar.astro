---
/** GitHub avatar when the account is known, otherwise the person's initials. */
import { avatarUrl, initials, type Contributor } from "@/lib/contributors";
interface Props {
  person: Pick<Contributor, "name" | "login" | "githubId">;
  size?: number;
  class?: string;
}
const { person, size = 48, class: cls = "" } = Astro.props;
const src = avatarUrl(person, size * 2);
---
{src ? (
  <img
    src={src}
    alt={`GitHub avatar of ${person.name}`}
    width={size}
    height={size}
    loading="lazy"
    decoding="async"
    class={`shrink-0 rounded-full border bg-secondary ${cls}`}
    style={`width:${size}px;height:${size}px`}
  />
) : (
  <span
    class={`grid shrink-0 place-items-center rounded-full bg-primary/10 font-bold text-primary ${cls}`}
    style={`width:${size}px;height:${size}px;font-size:${Math.round(size / 2.6)}px`}
    aria-hidden="true"
  >
    {initials(person.name)}
  </span>
)}
