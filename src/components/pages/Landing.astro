---
/** Landing page, shared by / (en), /kn and /hi. */
import Base from "@/layouts/Base.astro";
import { faqs } from "@/data/faq";
import { branches, SEMESTER_ORD } from "@/data/branches";
import { countSubjects, popularSubjectsMixed, subjectPath } from "@/data/subjects";
import { tools } from "@/data/tools";
import { SITE_NAME } from "@/lib/site";
import { branchText, FAQ_TEXT, SEM_ORD, toolText } from "@/i18n/content";
import { hasTranslation, localePath, t, type Lang } from "@/i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const L = d.landing;
const loc = (path: string) => (hasTranslation(path) ? localePath(lang, path) : path);

const seo = {
  en: {
    title: `VTU Notes, Syllabus & SGPA Calculator · ${SITE_NAME}`,
    description: "Free VTU notes, unit-wise study guides, important questions, syllabus maps and SGPA/CGPA calculators for CSE, ISE, ECE, EEE, ME and Civil (2022 scheme).",
    keywords: "VTU notes, VTU CSE notes, VTU syllabus, VTU important questions, VTU SGPA calculator, VTU CGPA calculator, VTU 2022 scheme, VTU study material",
  },
  kn: {
    title: `VTU ನೋಟ್ಸ್, ಪಠ್ಯಕ್ರಮ ಮತ್ತು SGPA ಕ್ಯಾಲ್ಕುಲೇಟರ್ · ${SITE_NAME}`,
    description: "CSE, ISE, ECE, EEE, ಮೆಕ್ಯಾನಿಕಲ್ ಮತ್ತು ಸಿವಿಲ್‌ಗೆ ಉಚಿತ VTU ನೋಟ್ಸ್, ಘಟಕವಾರು ಅಧ್ಯಯನ ಮಾರ್ಗದರ್ಶಿ, ಪ್ರಮುಖ ಪ್ರಶ್ನೆಗಳು ಮತ್ತು SGPA/CGPA ಕ್ಯಾಲ್ಕುಲೇಟರ್ (2022 ಸ್ಕೀಮ್).",
    keywords: "VTU ನೋಟ್ಸ್, VTU ಕನ್ನಡ, VTU ಪಠ್ಯಕ್ರಮ, VTU SGPA ಕ್ಯಾಲ್ಕುಲೇಟರ್, VTU CSE ನೋಟ್ಸ್, ವಿಶ್ವೇಶ್ವರಯ್ಯ ತಾಂತ್ರಿಕ ವಿಶ್ವವಿದ್ಯಾಲಯ",
  },
  hi: {
    title: `VTU नोट्स, सिलेबस और SGPA कैलकुलेटर · ${SITE_NAME}`,
    description: "CSE, ISE, ECE, EEE, मैकेनिकल और सिविल के लिए मुफ़्त VTU नोट्स, यूनिट-वार स्टडी गाइड, महत्वपूर्ण प्रश्न और SGPA/CGPA कैलकुलेटर (2022 स्कीम)।",
    keywords: "VTU नोट्स, VTU हिंदी, VTU सिलेबस, VTU SGPA कैलकुलेटर, VTU CSE नोट्स, विश्वेश्वरय्या टेक्नोलॉजिकल यूनिवर्सिटी",
  },
}[lang];

const popular = popularSubjectsMixed(24)
  .filter((s, i, all) => all.findIndex((x) => x.name === s.name) === i)
  .slice(0, 6);
const homeFaqs = lang === "en" ? faqs.slice(0, 4).map((f) => ({ q: f.q, a: f.a.join(" ") })) : FAQ_TEXT[lang].slice(0, 4);
const quickLinks = [
  { label: L.quick.sgpa, href: loc("/tools/sgpa") },
  { label: L.quick.cse, href: loc("/vtu/cse") },
  { label: L.quick.timetable, href: "/updates/exam-timetable" },
  { label: L.quick.cgpa, href: loc("/tools/cgpa") },
];
const featuredTools = tools
  .filter((tool) => ["sgpa", "cgpa", "attendance"].includes(tool.slug))
  .map((tool) => ({ ...toolText(lang, tool.slug, { name: tool.name, description: tool.description, answer: "" }), href: loc(tool.href) }));
---

<Base title={seo.title} description={seo.description} path={localePath(lang, "/")} keywords={seo.keywords} faqs={homeFaqs} lang={lang}>
  <section class="grid items-center gap-10 py-4 md:py-8 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:gap-14">
    <div>
      <p class="text-sm font-semibold text-primary">{L.eyebrow}</p>
      <h1 class="mt-3 text-3xl font-bold leading-[1.2] tracking-tight md:text-[2.75rem]">{L.h1}</h1>
      <p class="aio-answer aio-plain mt-5 max-w-xl text-base leading-relaxed text-muted md:text-lg">{L.intro}</p>
      <form action="/search" method="get" role="search" class="mt-7 flex max-w-xl gap-2">
        <label class="sr-only" for="home-q">{d.searchLabel}</label>
        <input id="home-q" name="q" type="search" placeholder={d.heroPlaceholder} class="h-12 min-w-0 flex-1 rounded-lg border bg-surface px-4 text-base shadow-sm" />
        <button type="submit" class="h-12 shrink-0 rounded-lg bg-primary px-5 font-semibold text-primary-foreground hover:bg-primary-hover">{d.search}</button>
      </form>
      <ul class="mt-4 flex flex-wrap items-center gap-2 text-sm">
        <li class="text-muted">{L.popular}</li>
        {quickLinks.map((l) => (
          <li><a class="rounded-full border bg-surface px-3 py-1 font-medium hover:border-primary hover:text-primary" href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="rounded-2xl border bg-secondary/60 p-5 shadow-sm md:p-7">
      <h2 class="text-lg font-semibold">{L.finderTitle}</h2>
      <p class="mt-1 text-sm text-muted">{L.finderText}</p>
      <form id="quick-finder" action={localePath(lang, "/vtu")} method="get" data-base={lang === "en" ? "" : `/${lang}`} class="mt-5 space-y-4">
        <div>
          <label for="qf-branch" class="mb-1.5 flex items-center gap-2 text-sm font-medium">
            <span class="grid size-5 place-items-center rounded-full bg-primary text-[11px] font-bold text-primary-foreground" aria-hidden="true">1</span>
            {L.yourBranch}
          </label>
          <select id="qf-branch" name="branch" required class="h-12 w-full rounded-lg border bg-surface px-3 text-base">
            <option value="" disabled selected>{L.selectBranch}</option>
            {branches.map((b) => <option value={b.slug}>{b.shortName} · {branchText(lang, b.slug, b).name}</option>)}
          </select>
        </div>
        <div>
          <label for="qf-sem" class="mb-1.5 flex items-center gap-2 text-sm font-medium">
            <span class="grid size-5 place-items-center rounded-full bg-primary text-[11px] font-bold text-primary-foreground" aria-hidden="true">2</span>
            {L.yourSemester}
          </label>
          <select id="qf-sem" name="semester" required class="h-12 w-full rounded-lg border bg-surface px-3 text-base">
            <option value="" disabled selected>{L.selectSemester}</option>
            {SEMESTER_ORD.map((ord, i) => <option value={`${ord}-semester`}>{L.semesterOption(SEM_ORD[lang][i])}</option>)}
          </select>
        </div>
        <button type="submit" class="flex h-12 w-full items-center justify-center gap-2 rounded-lg bg-primary font-semibold text-primary-foreground hover:bg-primary-hover">
          {L.showSubjects} <span aria-hidden="true">→</span>
        </button>
      </form>
      <p class="mt-4 text-center text-xs text-muted">{L.finderFoot}</p>
    </div>
  </section>
  <script is:inline>
    (function () {
      var f = document.getElementById("quick-finder");
      if (!f) return;
      f.addEventListener("submit", function (e) {
        e.preventDefault();
        var b = f.elements.namedItem("branch").value;
        var s = f.elements.namedItem("semester").value;
        if (b && s) location.href = (f.getAttribute("data-base") || "") + "/vtu/" + b + "/" + s;
      });
    })();
  </script>

  <section class="mt-12" aria-labelledby="how">
    <h2 id="how" class="text-center text-xl font-semibold md:text-2xl">{L.howTitle}</h2>
    <ol class="mt-6 grid gap-4 md:grid-cols-3">
      {L.how.map(([title, text], i) => (
        <li class="flex gap-4 rounded-xl border bg-surface p-5">
          <span class="grid size-9 shrink-0 place-items-center rounded-full bg-primary font-bold text-primary-foreground" aria-hidden="true">{i + 1}</span>
          <div>
            <p class="font-semibold">{title}</p>
            <p class="mt-1 text-sm text-muted">{text}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="mt-14" aria-labelledby="branches">
    <div class="flex flex-wrap items-end justify-between gap-2">
      <div>
        <p class="text-sm font-semibold text-primary">{L.step1}</p>
        <h2 id="branches" class="text-xl font-semibold md:text-2xl">{L.chooseBranch}</h2>
      </div>
      <a class="text-sm font-medium text-primary hover:underline" href={loc("/vtu")}>{L.allBranches} →</a>
    </div>
    <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {branches.map((b) => (
        <li>
          <a href={loc(`/vtu/${b.slug}`)} class="group flex h-full items-center gap-4 rounded-xl border bg-surface p-4 transition hover:border-primary hover:shadow-sm">
            <span class="grid size-12 shrink-0 place-items-center rounded-lg bg-primary/10 text-sm font-bold text-primary" aria-hidden="true">{b.shortName}</span>
            <span class="min-w-0 flex-1">
              <span class="block font-semibold group-hover:text-primary">{b.shortName}</span>
              <span class="block text-sm text-muted">{branchText(lang, b.slug, b).name}</span>
              <span class="mt-1 block text-xs text-faint">{L.subjects(countSubjects(b.slug))}</span>
            </span>
            <span class="text-faint group-hover:text-primary" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-10 rounded-xl border bg-surface p-5" aria-labelledby="sems">
    <h2 id="sems" class="font-semibold">{L.semTitle}</h2>
    <p class="mt-1 text-sm text-muted">{L.semText}</p>
    <ul class="mt-4 grid grid-cols-4 gap-2 sm:grid-cols-8">
      {SEMESTER_ORD.map((ord, i) => (
        <li>
          <a class="flex h-12 items-center justify-center rounded-lg border bg-secondary/60 font-semibold hover:border-primary hover:text-primary" href={`/semesters/${ord}-semester`} aria-label={L.semesterOption(SEM_ORD[lang][i])}>{SEM_ORD[lang][i]}</a>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-14" aria-labelledby="calc">
    <div class="flex flex-wrap items-end justify-between gap-2">
      <h2 id="calc" class="text-xl font-semibold md:text-2xl">{L.calcTitle}</h2>
      <a class="text-sm font-medium text-primary hover:underline" href={loc("/tools")}>{L.allCalcs} →</a>
    </div>
    <ul class="mt-5 grid gap-3 md:grid-cols-3">
      {featuredTools.map((tool) => (
        <li>
          <a href={tool.href} class="group flex h-full flex-col rounded-xl border bg-surface p-5 hover:border-primary hover:shadow-sm">
            <span class="font-semibold group-hover:text-primary">{tool.name}</span>
            <span class="mt-2 flex-1 text-sm text-muted">{tool.description}</span>
            <span class="mt-4 text-sm font-semibold text-primary">{L.openCalc} →</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-14" aria-labelledby="popular">
    <h2 id="popular" class="text-xl font-semibold md:text-2xl">{L.popularSubjects}</h2>
    <ul class="mt-5 grid gap-3 sm:grid-cols-2">
      {popular.map((s) => (
        <li>
          <a class="group flex items-center gap-3 rounded-xl border bg-surface p-4 hover:border-primary" href={subjectPath(s)} hreflang="en">
            <span class="shrink-0 rounded-md bg-secondary px-2 py-1 font-mono text-xs text-muted">{s.code}</span>
            <span class="min-w-0 flex-1">
              <span class="block font-medium group-hover:text-primary">{s.name}</span>
              <span class="block text-xs text-faint">{s.branch.toUpperCase()} · {L.semesterShort(s.semester)}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-14" aria-labelledby="faq">
    <h2 id="faq" class="text-xl font-semibold md:text-2xl">{L.faqTitle}</h2>
    <div class="mt-5 divide-y rounded-xl border bg-surface">
      {homeFaqs.map((f) => (
        <details class="group p-4">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium">
            {f.q}
            <span class="text-faint transition group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-muted">{f.a}</p>
        </details>
      ))}
    </div>
    <p class="mt-4 text-sm"><a class="font-medium text-primary hover:underline" href={loc("/faq")}>{L.moreFaq} →</a></p>
  </section>
</Base>
