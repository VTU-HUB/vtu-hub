---
import Base from "@/layouts/Base.astro";
import Crumbs from "@/components/site/Crumbs.astro";
import PageHeader from "@/components/site/PageHeader.astro";
import { articles } from "@/data/articles";
import { branches, schemes, semesterName, semesterPath } from "@/data/branches";
import { resourceTypes } from "@/data/resource-types";
import { tools } from "@/data/tools";
import { updates } from "@/data/updates";
---
<Base title="Sitemap: All VTU Branches, Semesters and Tools" description="All major VTUHub sections: branches, semesters, resources, tools, updates and legal pages." path="/sitemap" crumbs={[{ label: "Sitemap", href: "/sitemap" }]}>
  <Crumbs items={[{ label: "Sitemap" }]} />
  <PageHeader title="Sitemap" answer="A human-readable map of VTUHub. The machine-readable file is the XML sitemap, and AI crawlers can read llms.txt." />
  <section class="mt-10">
    <h2 class="text-lg font-semibold">Start</h2>
    <ul class="mt-3 columns-1 text-sm sm:columns-2 md:columns-3">
      <li class="py-1"><a class="text-primary hover:underline" href="/">Home</a></li>
      <li class="py-1"><a class="text-primary hover:underline" href="/vtu">Browse VTU</a></li>
      <li class="py-1"><a class="text-primary hover:underline" href="/faq">FAQ</a></li>
      <li class="py-1"><a class="text-primary hover:underline" href="/schemes">Schemes</a></li>
      <li class="py-1"><a class="text-primary hover:underline" href="/semesters">Semesters</a></li>
      <li class="py-1"><a class="text-primary hover:underline" href="/llms.txt">llms.txt</a></li>
    </ul>
  </section>
  <section class="mt-10">
    <h2 class="text-lg font-semibold">Kannada and Hindi</h2>
    <div class="mt-3 grid gap-6 sm:grid-cols-2">
      {([["kn", "ಕನ್ನಡ (Kannada)"], ["hi", "हिंदी (Hindi)"]] as const).map(([l, label]) => (
        <div>
          <h3 class="text-sm font-semibold" lang={l}>{label}</h3>
          <ul class="mt-2 text-sm">
            <li class="py-1"><a class="text-primary hover:underline" hreflang={l} href={`/${l}`}>{l === "kn" ? "ಮುಖಪುಟ" : "होम"}</a></li>
            <li class="py-1"><a class="text-primary hover:underline" hreflang={l} href={`/${l}/vtu`}>{l === "kn" ? "ಬ್ರಾಂಚ್ ಪ್ರಕಾರ ನೋಟ್ಸ್" : "ब्रांच के अनुसार नोट्स"}</a></li>
            {branches.map((b) => (
              <li class="py-1"><a class="text-primary hover:underline" hreflang={l} href={`/${l}/vtu/${b.slug}`}>VTU {b.shortName}</a></li>
            ))}
            <li class="py-1"><a class="text-primary hover:underline" hreflang={l} href={`/${l}/tools`}>{l === "kn" ? "ಕ್ಯಾಲ್ಕುಲೇಟರ್‌ಗಳು" : "कैलकुलेटर"}</a></li>
            <li class="py-1"><a class="text-primary hover:underline" hreflang={l} href={`/${l}/faq`}>{l === "kn" ? "ಪ್ರಶ್ನೋತ್ತರ" : "सामान्य प्रश्न"}</a></li>
          </ul>
        </div>
      ))}
    </div>
  </section>
  <section class="mt-10">
    <h2 class="text-lg font-semibold">Schemes and branches</h2>
    <ul class="mt-3 columns-1 text-sm sm:columns-2 md:columns-3">
      {schemes.map((s) => <li class="py-1"><a class="text-primary hover:underline" href={`/schemes/${s.year}`}>{s.name}</a></li>)}
      {branches.map((b) => <li class="py-1"><a class="text-primary hover:underline" href={`/vtu/${b.slug}`}>{b.shortName}</a></li>)}
      {[1, 2, 3, 4, 5, 6, 7, 8].map((n) => <li class="py-1"><a class="text-primary hover:underline" href={semesterPath(n)}>{semesterName(n)}</a></li>)}
    </ul>
  </section>
  <section class="mt-10">
    <h2 class="text-lg font-semibold">Resources, tools, articles</h2>
    <ul class="mt-3 columns-1 text-sm sm:columns-2 md:columns-3">
      {resourceTypes.map((t) => <li class="py-1"><a class="text-primary hover:underline" href={`/resources/${t.slug}`}>{t.label}</a></li>)}
      <li class="py-1"><a class="text-primary hover:underline" href="/resources/study-materials">Study materials</a></li>
      {tools.map((t) => <li class="py-1"><a class="text-primary hover:underline" href={t.href}>{t.name}</a></li>)}
      {articles.map((a) => <li class="py-1"><a class="text-primary hover:underline" href={`/articles/${a.slug}`}>{a.title}</a></li>)}
      {updates.map((u) => <li class="py-1"><a class="text-primary hover:underline" href={`/updates/${u.slug}`}>{u.title}</a></li>)}
    </ul>
  </section>
</Base>
