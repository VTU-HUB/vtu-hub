---
import Base from "@/layouts/Base.astro";
import Crumbs from "@/components/site/Crumbs.astro";
import FileTable from "@/components/site/FileTable.astro";
import Notice from "@/components/site/Notice.astro";
import PageHeader from "@/components/site/PageHeader.astro";
import { branches } from "@/data/branches";
import { getResourceType, isResourceType, resourceTypes } from "@/data/resource-types";
import { resourcesByType } from "@/data/resources";

export function getStaticPaths() {
  return resourceTypes.map((t) => ({ params: { type: t.slug } }));
}

const type = getResourceType(Astro.params.type)!;
if (!isResourceType(type.slug)) throw new Error("bad type");
const files = resourcesByType(type.slug).slice(0, 120);
---
<Base
  title={`VTU ${type.label}`}
  description={type.description}
  path={`/resources/${type.slug}`}
  crumbs={[{ label: "Resources", href: "/resources" }, { label: type.label, href: `/resources/${type.slug}` }]}
>
  <Crumbs items={[{ label: "Resources", href: "/resources" }, { label: type.label }]} />
  <PageHeader title={type.label} answer={type.description} />
  <div class="mb-6 flex flex-wrap gap-2" role="group" aria-label="Filter by branch">
    <button type="button" data-filter="" class="branch-filter inline-flex h-11 items-center rounded-md border border-primary bg-secondary px-3 text-sm font-medium">All branches</button>
    {branches.map((b) => (
      <button type="button" data-filter={b.slug} class="branch-filter inline-flex h-11 items-center rounded-md border bg-surface px-3 text-sm font-medium hover:border-primary/40">{b.shortName}</button>
    ))}
  </div>
  <Notice class="mb-6">{files.length} original guides shown. Open a subject for the full list. We do not host university paper PDFs. <a class="text-primary hover:underline" href="/resources/study-materials">Study materials</a></Notice>
  <FileTable files={files} showSubject />
</Base>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".branch-filter");
  const rows = document.querySelectorAll<HTMLElement>("[data-branch]");
  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const branch = button.dataset.filter ?? "";
      buttons.forEach((b) => {
        const on = b === button;
        b.classList.toggle("border-primary", on);
        b.classList.toggle("bg-secondary", on);
        b.classList.toggle("bg-surface", !on);
      });
      rows.forEach((row) => {
        row.hidden = Boolean(branch) && row.dataset.branch !== branch;
      });
    });
  });
</script>
