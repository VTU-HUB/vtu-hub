---
import Base from "@/layouts/Base.astro";
import Crumbs from "@/components/site/Crumbs.astro";
import PageHeader from "@/components/site/PageHeader.astro";
import { faqs } from "@/data/faq";

const items = faqs.map((f) => ({ q: f.q, a: f.a.join(" ") }));
---
<Base
  title="VTU FAQ: SGPA, CGPA, Schemes, CIE and SEE"
  description="Answers about VTUHub, schemes, SGPA, attendance, subject codes and how to report errors."
  path="/faq"
  crumbs={[{ label: "FAQ", href: "/faq" }]}
  faqs={items}
>
  <Crumbs items={[{ label: "FAQ" }]} />
  <PageHeader title="Frequently asked questions" answer="VTUHub is not the official VTU website. It organises original study guides and calculators for students in Karnataka. Circulars, dates and results that count live on vtu.ac.in." />
  <div class="max-w-3xl divide-y border-t">
    {faqs.map((f) => (
      <section class="py-6">
        <h2 class="text-lg font-semibold">{f.q}</h2>
        {f.a.map((p) => <p class="mt-3 leading-relaxed text-muted">{p}</p>)}
      </section>
    ))}
  </div>
  <p class="mt-8 text-sm text-muted">Still stuck? <a class="text-primary hover:underline" href="/contact">Contact</a> · <a class="text-primary hover:underline" href="/about">About VTUHub</a></p>
</Base>
