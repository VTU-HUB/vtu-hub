---
import Base from "@/layouts/Base.astro";
import Crumbs from "@/components/site/Crumbs.astro";
import FileTable from "@/components/site/FileTable.astro";
import NotesPdf from "@/components/site/NotesPdf.astro";
import Notice from "@/components/site/Notice.astro";
import PageHeader from "@/components/site/PageHeader.astro";
import { notesFilename, type NotesInput } from "@/lib/notes-doc";
import { notesFor } from "@/data/notes";
import { getBranch, semesterName, semesterSlug } from "@/data/branches";
import { getResourceType } from "@/data/resource-types";
import { getResource, isIndexable, relatedFiles, resources, subjectFor, typePath } from "@/data/resources";
import { subjectPath } from "@/data/subjects";
import { absUrl, OFFICIAL_VTU_URL, OG_IMAGE, SITE_URL } from "@/lib/site";
import { clampDesc, fitTitle } from "@/lib/seo-doc";
import { formatFullDate } from "@/lib/utils";

export function getStaticPaths() {
  return resources.map((file) => ({ params: { id: file.id } }));
}

const file = getResource(Astro.params.id)!;
const branch = getBranch(file.branch);
const type = getResourceType(file.type);
const subject = subjectFor(file);
const related = relatedFiles(file);
const sem = semesterSlug(file.semester);
const path = `/files/${file.id}`;
const br = branch?.shortName ?? file.branch.toUpperCase();
const code = subject?.code ?? "";
const hasCode = code !== "" && file.title.includes(code);
const seoTitle = fitTitle(
  `${file.title}${code && !hasCode ? ` (${code})` : ""} – VTU ${br} Sem ${file.semester}`,
  `${file.title}${code && !hasCode ? ` (${code})` : ""} – VTU ${br}`,
  `${file.title} – VTU ${br}`,
  `${file.title.replace(" — Introduction and fundamentals", ": Introduction")} – VTU ${br}`,
  `${file.title} – ${br}`,
);
const seoDesc = clampDesc(
  `VTU ${br} ${semesterName(file.semester)}${subject ? `, ${subject.code}` : ""}: ${file.description} ${subject ? `${subject.name}, ` : ""}${subject?.scheme ?? "2022"} scheme. Free original study guide.`,
);
const notes: NotesInput | null = subject
  ? {
      filename: notesFilename(subject.code, subject.slug),
      code: subject.code,
      name: subject.name,
      programme: branch?.name ?? br,
      semester: semesterName(file.semester),
      scheme: subject.scheme,
      credits: subject.credits,
      description: subject.description,
      textbooks: subject.textbooks ?? [],
      references: subject.references ?? [],
      outcomes: subject.outcomes,
      units: subject.units,
      notesMarkdown: notesFor(subject.code)?.rawContent(),
    }
  : null;
const crumbTrail = subject
  ? [
      { label: "VTU", href: "/vtu" },
      { label: br, href: `/vtu/${file.branch}` },
      { label: semesterName(file.semester), href: `/vtu/${file.branch}/${sem}` },
      { label: subject.shortName, href: subjectPath(subject) },
      { label: file.title, href: path },
    ]
  : [
      { label: "Resources", href: "/resources" },
      { label: type?.label ?? file.type, href: `/resources/${file.type}` },
      { label: file.title, href: path },
    ];
---
<Base
  title={seoTitle}
  description={seoDesc}
  path={path}
  noindex={!isIndexable(file)}
  ogType="article"
  published={file.updated}
  updated={file.updated}
  crumbs={crumbTrail}
  extraJsonLd={[{
    "@type": "Article",
    headline: file.title,
    description: seoDesc,
    image: { "@type": "ImageObject", url: absUrl(OG_IMAGE.path), width: OG_IMAGE.width, height: OG_IMAGE.height, caption: OG_IMAGE.alt },
    datePublished: file.updated,
    dateModified: file.updated,
    ...(subject ? { about: { "@type": "Course", name: subject.name, courseCode: subject.code, provider: { "@type": "CollegeOrUniversity", name: "Visvesvaraya Technological University", sameAs: OFFICIAL_VTU_URL } } } : {}),
    inLanguage: "en-IN",
    mainEntityOfPage: absUrl(path),
    author: { "@id": `${SITE_URL}/#organization` },
    publisher: { "@id": `${SITE_URL}/#organization` },
  }]}
>
  <Crumbs items={crumbTrail.map((c, i) => (i === crumbTrail.length - 1 ? { label: c.label } : c))} />
  <PageHeader
    kicker={`${type?.label ?? file.type} · original guide`}
    title={file.title}
    answer={file.description}
  >
    <p slot="meta" class="mt-3 flex flex-wrap gap-x-3 text-sm text-muted">
      {branch ? <span>{branch.shortName}</span> : null}
      <span>{semesterName(file.semester)}</span>
      {subject ? <span>{subject.code}</span> : null}
      <span>{file.readMinutes} min read</span>
      <span>Updated {formatFullDate(file.updated)}</span>
    </p>
  </PageHeader>
  <dl class="grid gap-3 text-sm sm:grid-cols-2 lg:grid-cols-3">
    <div class="rounded-md border bg-surface px-4 py-3"><dt class="text-xs font-medium uppercase tracking-wider text-faint">Branch</dt><dd class="mt-1 font-medium"><a class="hover:text-primary" href={`/vtu/${file.branch}`}>{branch?.name ?? file.branch}</a></dd></div>
    <div class="rounded-md border bg-surface px-4 py-3"><dt class="text-xs font-medium uppercase tracking-wider text-faint">Semester</dt><dd class="mt-1 font-medium"><a class="hover:text-primary" href={`/vtu/${file.branch}/${sem}`}>{semesterName(file.semester)}</a></dd></div>
    {subject ? <div class="rounded-md border bg-surface px-4 py-3"><dt class="text-xs font-medium uppercase tracking-wider text-faint">Subject</dt><dd class="mt-1 font-medium"><a class="hover:text-primary" href={subjectPath(subject)}>{subject.name} ({subject.code})</a></dd></div> : null}
    <div class="rounded-md border bg-surface px-4 py-3"><dt class="text-xs font-medium uppercase tracking-wider text-faint">Scheme</dt><dd class="mt-1 font-medium"><a class="hover:text-primary" href="/schemes/2022">{subject?.scheme ?? "2022"} scheme</a></dd></div>
    <div class="rounded-md border bg-surface px-4 py-3"><dt class="text-xs font-medium uppercase tracking-wider text-faint">Type</dt><dd class="mt-1 font-medium"><a class="hover:text-primary" href={`/resources/${file.type}`}>{type?.label ?? file.type}</a></dd></div>
    {file.unit ? <div class="rounded-md border bg-surface px-4 py-3"><dt class="text-xs font-medium uppercase tracking-wider text-faint">Unit</dt><dd class="mt-1 font-medium">Unit {file.unit}</dd></div> : null}
  </dl>
  <div class="no-print mt-6 flex flex-wrap gap-2">
    <a href="#notes" class="inline-flex h-11 items-center gap-2 rounded-lg bg-primary px-4 font-semibold text-primary-foreground hover:bg-primary-hover">
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 4h6a4 4 0 0 1 4 4v12a3 3 0 0 0-3-3H2z"></path><path d="M22 4h-6a4 4 0 0 0-4 4v12a3 3 0 0 1 3-3h7z"></path></svg>
      Read online
    </a>
    {notes ? <NotesPdf notes={notes} /> : null}
    <button type="button" data-print-guide class="inline-flex h-11 items-center gap-2 rounded-lg border bg-surface px-4 font-semibold hover:border-primary hover:text-primary">
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9V2h12v7"></path><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><path d="M6 14h12v8H6z"></path></svg>
      Print
    </button>
    <span class="self-center text-xs text-muted">The PDF includes every module and the prescribed textbooks. Print keeps this page only.</span>
  </div>
  <Notice class="mt-8">Original VTUHub writing. Not an official VTU circular and not a scanned university paper. Confirm module titles on <a class="text-primary hover:underline" href={OFFICIAL_VTU_URL}>vtu.ac.in</a>.</Notice>
  <article id="notes" class="mt-8 max-w-3xl scroll-mt-24 space-y-4 text-[15px] leading-relaxed text-muted">
    {file.body.map((p) => <p>{p}</p>)}
    {file.bullets && file.bullets.length > 0 ? (
      <ul class="list-disc space-y-1.5 pl-5">{file.bullets.map((b) => <li>{b}</li>)}</ul>
    ) : null}
    <p class="print-only mt-8 border-t pt-3 text-xs">Source: vtuhub.site/files/{file.id} · Free VTU study guide · Check official dates on vtu.ac.in</p>
  </article>
  <script is:inline>
    (function () {
      function save() { window.print(); }
      document.querySelectorAll("[data-print-guide]").forEach(function (b) { b.addEventListener("click", save); });
      if (location.hash === "#print") setTimeout(save, 400);
    })();
  </script>
  {subject ? (
    <p class="mt-8 text-sm"><a class="text-primary hover:underline" href={typePath(file.branch, file.semester, file.subjectSlug, file.type)}>All {type?.label.toLowerCase() ?? "guides"} for {subject.shortName}</a></p>
  ) : null}
  {related.length > 0 ? (
    <section class="mt-10">
      <h2 class="mb-4 text-lg font-semibold">Related guides</h2>
      <FileTable files={related} />
    </section>
  ) : null}
</Base>
