---
import Base from "@/layouts/Base.astro";
import Crumbs from "@/components/site/Crumbs.astro";
import PageHeader from "@/components/site/PageHeader.astro";
import { COPYRIGHT_EMAIL } from "@/lib/site";
---
<Base title="Copyright Policy and Takedown Notices" description="VTUHub hosts original guides only. How rights holders can send a notice." path="/copyright" crumbs={[{ label: "Copyright", href: "/copyright" }]}>
  <Crumbs items={[{ label: "Copyright" }]} />
  <PageHeader title="Copyright" answer="VTUHub publishes original guides. It does not host scanned VTU question papers, faculty notes, college lab manuals, or official scheme PDFs.">
    <p slot="meta" class="mt-3 text-sm text-muted">Last updated 6 September 2026</p>
  </PageHeader>
  <div class="max-w-3xl space-y-4 text-[15px] leading-relaxed text-muted">
    <h2 class="text-xl font-semibold text-foreground">What we publish</h2>
    <p>Layout, original articles, original subject guides, calculator interfaces and the organisation of pages are produced for VTUHub. You may quote short passages with a link back. You may not copy the site wholesale.</p>
    <h2 class="mt-10 text-xl font-semibold text-foreground">What we do not host</h2>
    <ul class="list-disc space-y-1.5 pl-5">
      <li>Scanned or photographed VTU semester-end question papers.</li>
      <li>Faculty or publisher notes we do not own.</li>
      <li>College lab manuals or observation books.</li>
      <li>Official scheme PDFs (those live on vtu.ac.in).</li>
    </ul>
    <p>Subject codes, scheme names and university circulars belong to Visvesvaraya Technological University. We describe publicly known structures so students can find the right page; we do not reproduce the university’s documents as downloads.</p>
    <h2 class="mt-10 text-xl font-semibold text-foreground">Send a notice</h2>
    <p>Email <a class="text-primary hover:underline" href={`mailto:${COPYRIGHT_EMAIL}`}>{COPYRIGHT_EMAIL}</a> with your name, the work you own, the exact VTUHub URL, and a statement that you are the owner or an authorised agent. We review specific, plausible claims. We do not accept bulk “take down everything in this folder” emails without URLs.</p>
  </div>
</Base>
