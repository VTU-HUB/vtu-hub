---
import Base from "@/layouts/Base.astro";
import Crumbs from "@/components/site/Crumbs.astro";
import PageHeader from "@/components/site/PageHeader.astro";
import { schemes } from "@/data/branches";
import { schemePages } from "@/data/scheme-pages";
---
<Base
  title="VTU schemes — 2022, 2021 and 2018"
  description="How VTU 2022, 2021 and 2018 schemes differ: subject codes, CIE/SEE splits and which papers to practise."
  path="/schemes"
  crumbs={[{ label: "Schemes", href: "/schemes" }]}
  faqs={schemes.map((s) => ({ q: `What is the VTU ${s.year} scheme?`, a: `${s.description} ${schemePages[s.year].cieSee}` }))}
>
  <Crumbs items={[{ label: "Schemes" }]} />
  <PageHeader
    title="VTU schemes"
    answer="A scheme is the regulation your batch is examined under. Match the year on your admission ticket before you use notes or the marks calculator. 2022 is usually 50 CIE + 50 SEE. 2018 was often 40 + 60."
  />
  <ul class="grid gap-3 md:grid-cols-3">
    {schemes.map((s) => (
      <li>
        <a class="flex h-full flex-col rounded-lg border bg-surface p-4 hover:border-primary/40" href={`/schemes/${s.year}`}>
          <p class="text-xs font-medium uppercase tracking-wider text-muted">{s.year}</p>
          <h2 class="mt-1 font-semibold">{s.name}</h2>
          <p class="mt-2 text-sm text-muted">{s.description}</p>
          <p class="mt-3 text-xs text-faint">{schemePages[s.year].cieSee}</p>
        </a>
      </li>
    ))}
  </ul>
</Base>
