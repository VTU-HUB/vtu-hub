---
import Base from "@/layouts/Base.astro";
import Browse from "@/components/site/Browse.astro";
import FileTable from "@/components/site/FileTable.astro";
import { faqs } from "@/data/faq";
import { latestQuestionPapers, popularNotes } from "@/data/resources";
import { popularSubjectsMixed, subjectPath } from "@/data/subjects";
import { tools } from "@/data/tools";
import { updates } from "@/data/updates";
import { SITE_DESCRIPTION, SITE_NAME } from "@/lib/site";
import { formatFullDate } from "@/lib/utils";

const popular = popularSubjectsMixed(8);
const papers = latestQuestionPapers(6);
const notes = popularNotes(6);
const homeFaqs = faqs.slice(0, 4).map((f) => ({ q: f.q, a: f.a.join(" ") }));
const catalog = [
  { href: "/schemes", label: "Schemes" },
  { href: "/resources/study-materials", label: "Study materials" },
  { href: "/faq", label: "FAQ" },
  { href: "/sitemap", label: "Sitemap" },
];
---

<Base
  title={`${SITE_NAME} · VTU study guides, calculators and scheme explainers`}
  description={SITE_DESCRIPTION}
  path="/"
  keywords="VTU study guides, VTU SGPA calculator, CSE syllabus, 2022 scheme, Karnataka engineering"
  faqs={homeFaqs}
>
  <section class="max-w-3xl">
    <p class="text-xs font-medium uppercase tracking-wider text-muted">Independent VTU resource platform · Karnataka</p>
    <h1 class="mt-2 text-3xl font-semibold leading-tight md:text-4xl">Study guides, calculators and scheme explainers — organised the way you study</h1>
    <p class="aio-answer mt-4 text-sm leading-relaxed">
      <span class="mb-1 block text-[11px] font-medium uppercase tracking-wider text-muted">Quick answer</span>
      VTUHub is an independent site for Visvesvaraya Technological University students in Karnataka. Open a semester to see every branch, then a subject for original unit guides, practice questions and the 2022-scheme code. Official dates and PDFs stay on vtu.ac.in.
    </p>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted md:text-base">
      Open a semester first. You get every branch — CSE, ISE, ECE, EEE, Mechanical and Civil.
    </p>
    <form action="/search" method="get" role="search" class="mt-5 max-w-xl">
      <label class="sr-only" for="home-q">Search</label>
      <input id="home-q" name="q" type="search" placeholder="Search a subject, code or tool" class="h-12 w-full rounded-md border bg-surface px-4" />
    </form>
    <div class="mt-5"><Browse kind="jump" /></div>
  </section>

  <section class="mt-8">
    <div class="mb-4 flex items-end justify-between"><h2 class="text-lg font-semibold md:text-xl">Browse by semester</h2><a class="text-sm font-medium text-primary hover:underline" href="/semesters">All semesters</a></div>
    <Browse kind="semesters" />
    <p class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm">
      {catalog.map((item) => <a class="font-medium text-primary hover:underline" href={item.href}>{item.label}</a>)}
    </p>
  </section>

  <section class="mt-12">
    <div class="mb-4 flex items-end justify-between"><h2 class="text-lg font-semibold md:text-xl">Browse by branch</h2><a class="text-sm font-medium text-primary hover:underline" href="/vtu">All branches</a></div>
    <Browse kind="branches" />
  </section>

  <section class="mt-14">
    <h2 class="mb-4 text-lg font-semibold">Popular subjects</h2>
    <ul class="divide-y border-t">
      {popular.map((s) => (
        <li>
          <a class="flex items-center gap-4 py-3.5 hover:bg-secondary/60" href={subjectPath(s)}>
            <span class="w-24 shrink-0 font-mono text-xs text-muted">{s.code}</span>
            <span class="min-w-0 flex-1">
              <span class="block font-medium">{s.name}</span>
              <span class="block text-xs text-faint">{s.branch.toUpperCase()} · Semester {s.semester}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-14">
    <div class="mb-4 flex items-end justify-between"><h2 class="text-lg font-semibold">Practice questions</h2><a class="text-sm font-medium text-primary hover:underline" href="/resources/question-papers">View all</a></div>
    <FileTable files={papers} showSubject />
  </section>

  <section class="mt-14">
    <div class="mb-4 flex items-end justify-between"><h2 class="text-lg font-semibold">Unit study guides</h2><a class="text-sm font-medium text-primary hover:underline" href="/resources/notes">View all</a></div>
    <FileTable files={notes} showSubject />
  </section>

  <section class="mt-14 grid gap-10 lg:grid-cols-2">
    <div>
      <div class="mb-4 flex items-end justify-between"><h2 class="text-lg font-semibold">VTU updates</h2><a class="text-sm font-medium text-primary hover:underline" href="/updates">View all</a></div>
      <ul class="divide-y border-t">
        {updates.slice(0, 4).map((u) => (
          <li class="py-3.5">
            <a class="block hover:text-primary" href={`/updates/${u.slug}`}>
              <span class="font-medium">{u.title}</span>
              <span class="mt-1 block text-xs text-faint">{formatFullDate(u.date)}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <div class="mb-4 flex items-end justify-between"><h2 class="text-lg font-semibold">Tools</h2><a class="text-sm font-medium text-primary hover:underline" href="/tools">View all</a></div>
      <ul class="divide-y border-t">
        {tools.map((t) => (
          <li class="py-3.5">
            <a class="block hover:text-primary" href={t.href}>
              <span class="font-medium">{t.name}</span>
              <span class="mt-1 block text-xs text-muted">{t.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="mt-14 max-w-3xl">
    <h2 class="text-lg font-semibold">Questions students ask</h2>
    {homeFaqs.map((f) => (
      <section class="mt-6 border-t pt-4">
        <h3 class="font-semibold">{f.q}</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">{f.a}</p>
      </section>
    ))}
  </section>
</Base>
