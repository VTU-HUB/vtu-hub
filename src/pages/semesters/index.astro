---
import Base from "@/layouts/Base.astro";
import Browse from "@/components/site/Browse.astro";
import Crumbs from "@/components/site/Crumbs.astro";
import PageHeader from "@/components/site/PageHeader.astro";
---
<Base
  title="VTU Notes by Semester: 1st to 8th Sem, All Branches"
  description="Open a VTU semester (1st to 8th) to see every programme that runs that term on the 2022 scheme, then pick yours for subject codes, credits and the official syllabus."
  path="/semesters"
  crumbs={[{ label: "Semesters", href: "/semesters" }]}
>
  <Crumbs items={[{ label: "Semesters" }]} />
  <PageHeader
    kicker="All programmes · Karnataka"
    title="VTU Notes by Semester: 1st to 8th Sem, All Branches"
    answer="Each semester page lists the VTU branches that run that term. You choose your programme — from CSE and AIML to Civil and Textile — after you open the semester. Nothing defaults to Computer Science."
  />
  <Browse kind="semesters" />
</Base>
