---
import Base from "@/layouts/Base.astro";

const destination = "/vtu";
---

<Base
  title="VTU Branches — Choose Your Programme"
  description="The VTU browser now starts with your engineering branch. Choose a branch first, then select your semester and subject."
  path="/semesters"
  canonical={destination}
  noindex
>
  <section class="mx-auto max-w-2xl text-center">
    <h1 class="text-2xl font-bold">Choose your VTU branch first</h1>
    <p class="mt-3 text-muted">The semester-first browser has been replaced. Select your branch, then choose your semester.</p>
    <p class="mt-6"><a class="text-primary underline" href={destination}>Browse VTU branches</a></p>
  </section>
  <script is:inline>window.location.replace("/vtu");</script>
</Base>
