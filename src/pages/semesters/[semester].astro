---
import Base from "@/layouts/Base.astro";
import Browse from "@/components/site/Browse.astro";
import Crumbs from "@/components/site/Crumbs.astro";
import Notice from "@/components/site/Notice.astro";
import PageHeader from "@/components/site/PageHeader.astro";
import { parseSemesterSlug, semesterAbout, semesterName, semesterSlug } from "@/data/branches";
import { branchesForSemester } from "@/data/subjects";

export function getStaticPaths() {
  return [1, 2, 3, 4, 5, 6, 7, 8]
    .filter((n) => branchesForSemester(n).length > 0)
    .map((n) => ({ params: { semester: semesterSlug(n) } }));
}

const n = parseSemesterSlug(Astro.params.semester)!;
const list = branchesForSemester(n);
const about = semesterAbout(n);
---
<Base
  title={`${semesterName(n)} · all VTU branches`}
  description={`Pick a branch for ${semesterName(n)}: ${list.map((b) => b.shortName).join(", ")}. Subjects, notes and question papers follow the branch you choose.`}
  path={`/semesters/${Astro.params.semester}`}
  crumbs={[{ label: "Semesters", href: "/semesters" }, { label: semesterName(n), href: `/semesters/${Astro.params.semester}` }]}
  faqs={[{ q: `Which branches run VTU ${semesterName(n)}?`, a: `${semesterName(n)} on VTUHub lists ${list.map((b) => b.shortName).join(", ")}. ${about}` }]}
>
  <Crumbs items={[{ label: "Semesters", href: "/semesters" }, { label: semesterName(n) }]} />
  <PageHeader kicker="All branches" title={semesterName(n)} answer={about} />
  <Notice class="mb-8">This page is the semester hub. Choose your branch below to open subjects and files for that programme. VTUHub never assumes Computer Science.</Notice>
  <Browse kind="switcher" semester={n} />
  <div class="mt-8">
    <h2 class="mb-4 text-lg font-semibold">Branches in this semester</h2>
    <Browse kind="branches" semester={n} />
  </div>
</Base>
