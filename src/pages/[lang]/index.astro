---
import Landing from "@/components/pages/Landing.astro";
import { TRANSLATED_LANGS } from "@/i18n/ui";

export function getStaticPaths() {
  return TRANSLATED_LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: (typeof TRANSLATED_LANGS)[number] };
---

<Landing lang={lang} />
