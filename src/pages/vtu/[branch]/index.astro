---
import Base from "@/layouts/Base.astro";
import Steps from "@/components/site/Steps.astro";
import Browse from "@/components/site/Browse.astro";
import Crumbs from "@/components/site/Crumbs.astro";
import PageHeader from "@/components/site/PageHeader.astro";
import { branches, getBranch } from "@/data/branches";
import { flagshipSubjects, getSubjectsByBranch } from "@/data/subjects";

export function getStaticPaths() {
  return branches.map((branch) => ({ params: { branch: branch.slug } }));
}

const branch = getBranch(Astro.params.branch)!;
const subjects = getSubjectsByBranch(branch.slug);
const featured = flagshipSubjects().filter((s) => s.branch === branch.slug);
---

<Base
  title={`VTU ${branch.shortName} Notes, Syllabus & Important Questions`}
  description={branch.description}
  path={`/vtu/${branch.slug}`}
  keywords={`VTU ${branch.shortName}, ${branch.name}, Karnataka, 2022 scheme`}
  crumbs={[{ label: "VTU", href: "/vtu" }, { label: branch.shortName, href: `/vtu/${branch.slug}` }]}
  faqs={[{ q: `Where do I find ${branch.shortName} notes?`, a: branch.about }]}
>
  <Crumbs items={[{ label: "VTU", href: "/vtu" }, { label: branch.shortName }]} />
  <Steps current={2} branch={{ label: branch.shortName, href: `/vtu/${branch.slug}` }} />
  <PageHeader kicker={`${branch.code} · 2022 scheme · Karnataka`} title={`VTU ${branch.name} (${branch.shortName})`} answer={branch.about} description={branch.description} />
  <section>
    <h2 class="mb-4 text-lg font-semibold">Choose your semester</h2>
    <Browse kind="semesters" branchSlug={branch.slug} />
  </section>
  {featured.length > 0 ? (
    <section class="mt-12">
      <h2 class="mb-4 text-lg font-semibold">Core subjects</h2>
      <Browse kind="subjects" subjects={featured} />
    </section>
  ) : null}
  <section class="mt-12">
    <h2 class="mb-4 text-lg font-semibold">All subjects</h2>
    <Browse kind="subjects" subjects={subjects} />
  </section>
</Base>
