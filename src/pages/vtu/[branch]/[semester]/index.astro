---
import Base from "@/layouts/Base.astro";
import Steps from "@/components/site/Steps.astro";
import { clampDesc, fitTitle } from "@/lib/seo-doc";
import Browse from "@/components/site/Browse.astro";
import Crumbs from "@/components/site/Crumbs.astro";
import Notice from "@/components/site/Notice.astro";
import PageHeader from "@/components/site/PageHeader.astro";
import { branches, getBranch, parseSemesterSlug, semesterAbout, semesterName, semesterPath, semesterSlug } from "@/data/branches";
import { getSubjectsBySemester } from "@/data/subjects";

export function getStaticPaths() {
  const paths = [];
  for (const branch of branches) {
    for (let n = 1; n <= 8; n++) {
      const subjects = getSubjectsBySemester(branch.slug, n);
      if (subjects.length === 0) continue;
      paths.push({ params: { branch: branch.slug, semester: semesterSlug(n) } });
    }
  }
  return paths;
}

const branch = getBranch(Astro.params.branch)!;
const n = parseSemesterSlug(Astro.params.semester)!;
const subjects = getSubjectsBySemester(branch.slug, n);
const about = semesterAbout(n, branch);
const seoTitle = fitTitle(
  `VTU ${branch.shortName} ${semesterName(n)} Notes, Subjects & Syllabus`,
  `VTU ${branch.shortName} ${semesterName(n)} Notes & Syllabus`,
);
const seoDesc = clampDesc(
  `VTU ${branch.shortName} ${semesterName(n)} (2022 scheme) subjects: ${subjects.map((s) => `${s.code} ${s.shortName}`).join(", ")}. Free unit-wise notes and important questions.`,
);
---

<Base
  title={seoTitle}
  description={seoDesc}
  keywords={`VTU ${branch.shortName} ${semesterName(n)} notes, VTU ${branch.shortName} ${n} sem subjects, VTU ${branch.shortName} ${n} sem syllabus, ${subjects.map((s) => s.code).join(", ")}`}
  path={`/vtu/${branch.slug}/${Astro.params.semester}`}
  crumbs={[
    { label: "VTU", href: "/vtu" },
    { label: branch.shortName, href: `/vtu/${branch.slug}` },
    { label: semesterName(n), href: `/vtu/${branch.slug}/${Astro.params.semester}` },
  ]}
  faqs={[{ q: `What is in VTU ${branch.shortName} ${semesterName(n)}?`, a: about }]}
>
  <Crumbs items={[
    { label: "VTU", href: "/vtu" },
    { label: branch.shortName, href: `/vtu/${branch.slug}` },
    { label: semesterName(n) },
  ]} />
  <Steps current={3} branch={{ label: branch.shortName, href: `/vtu/${branch.slug}` }} semester={{ label: semesterName(n), href: `/vtu/${branch.slug}/${Astro.params.semester}` }} />
  <PageHeader kicker={`${branch.shortName} · ${branch.code}`} title={`VTU ${branch.shortName} ${semesterName(n)}`} answer={about} />
  <Notice class="mb-6">
    You are viewing <strong class="text-foreground">{branch.shortName}</strong> for this semester. Other programmes have different subject codes. <a class="text-primary hover:underline" href={semesterPath(n)}>See all branches in {semesterName(n)}</a>.
  </Notice>
  <Browse kind="switcher" semester={n} current={branch.slug} />
  <section class="mt-8">
    <h2 class="mb-2 text-lg font-semibold">Choose your subject</h2>
    <p class="mb-4 text-sm text-muted">{subjects.length} papers on the {branch.shortName} {semesterName(n)} card.</p>
    <Browse kind="subjects" subjects={subjects} />
  </section>
</Base>
