---
import Base from "@/layouts/Base.astro";
import Steps from "@/components/site/Steps.astro";
import { clampDesc, fitTitle } from "@/lib/seo-doc";
import Crumbs from "@/components/site/Crumbs.astro";
import FileTable from "@/components/site/FileTable.astro";
import Notice from "@/components/site/Notice.astro";
import NotesPdf from "@/components/site/NotesPdf.astro";
import PageHeader from "@/components/site/PageHeader.astro";
import { notesFilename, type NotesInput } from "@/lib/notes-doc";
import { getBranch, parseSemesterSlug, semesterName, semesterSlug } from "@/data/branches";
import { resourceTypes } from "@/data/resource-types";
import { resourceCounts, resourcesFor } from "@/data/resources";
import { canonicalSubject, creditsLabel, getSubjectsBySemester, subjectPath, subjects } from "@/data/subjects";
import { branches } from "@/data/branches";
import { notesFor } from "@/data/notes";
import { absUrl, SITE_URL } from "@/lib/site";
import { formatFullDate } from "@/lib/utils";

export function getStaticPaths() {
  return subjects.map((subject) => ({
    params: {
      branch: subject.branch,
      semester: semesterSlug(subject.semester),
      subject: subject.slug,
    },
  }));
}

const branch = getBranch(Astro.params.branch)!;
const n = parseSemesterSlug(Astro.params.semester)!;
const subject = subjects.find((s) => s.branch === branch.slug && s.semester === n && s.slug === Astro.params.subject)!;
const files = resourcesFor(subject.branch, subject.semester, subject.slug);
const counts = resourceCounts(subject.branch, subject.semester, subject.slug);
const siblings = getSubjectsBySemester(branch.slug, n).filter((s) => s.slug !== subject.slug);
const path = subjectPath(subject);
const canonicalPath = subjectPath(canonicalSubject(subject));
const alsoIn = subjects
  .filter((s) => s.code === subject.code && s.branch !== subject.branch)
  .map((s) => ({ s, b: branches.find((b) => b.slug === s.branch)! }))
  .filter((x) => x.b);
const slotOptions = subject.electiveGroup
  ? getSubjectsBySemester(branch.slug, n).filter((s) => s.electiveGroup === subject.electiveGroup && s.slug !== subject.slug)
  : [];
const credits = creditsLabel(subject.credits);
const studyNotes = notesFor(subject.code);
const br = branch.shortName;
const seoTitle = fitTitle(
  `${subject.name} (${subject.code}) VTU ${br} Notes & Questions`,
  `${subject.name} (${subject.code}) – VTU ${br} Notes`,
  `${subject.code} ${subject.shortName} – VTU ${br} Notes & Questions`,
  `${subject.code} ${subject.shortName} – VTU ${br} Notes`,
  `${subject.code} ${subject.name} – VTU ${br}`,
  `${subject.code} ${subject.name} – VTU`,
  `${subject.code} ${subject.shortName} – VTU ${br}`,
  `${subject.code} ${subject.name}`,
  `${subject.code} ${subject.shortName}`,
);
const seoDesc = clampDesc(
  `${subject.code} ${subject.name}, VTU ${br} ${semesterName(n)} (${subject.scheme} scheme)${credits ? `, ${credits}` : ""}. ${subject.description}`,
);
const notes: NotesInput = {
  filename: notesFilename(subject.code, subject.slug),
  code: subject.code,
  name: subject.name,
  programme: branch.name,
  semester: semesterName(n),
  scheme: subject.scheme,
  credits: subject.credits,
  description: subject.description,
  textbooks: subject.textbooks ?? [],
  references: subject.references ?? [],
  outcomes: subject.outcomes,
  units: subject.units,
  notesMarkdown: studyNotes?.rawContent(),
};
const faqs = [
  { q: `What is ${subject.name} (${subject.code})?`, a: subject.description },
  ...(subject.credits != null
    ? [{ q: `How many credits is ${subject.code}?`, a: `${subject.name} is ${credits} on VTU's ${subject.scheme} scheme for ${branch.name}, ${semesterName(n)}, as printed in the official scheme PDF.` }]
    : []),
];
---

<Base
  title={seoTitle}
  description={seoDesc}
  path={path}
  canonical={canonicalPath}
  crumbs={[
    { label: "VTU", href: "/vtu" },
    { label: branch.shortName, href: `/vtu/${branch.slug}` },
    { label: semesterName(n), href: `/vtu/${branch.slug}/${Astro.params.semester}` },
    { label: subject.shortName, href: path },
  ]}
  faqs={faqs}
  extraJsonLd={[{
    "@type": "Course",
    name: subject.name,
    description: subject.description,
    courseCode: subject.code,
    ...(subject.credits != null ? { numberOfCredits: subject.credits } : {}),
    inLanguage: "en-IN",
    provider: { "@id": `${SITE_URL}/#organization` },
    educationalLevel: `VTU ${br} ${semesterName(n)}`,
    hasCourseInstance: { "@type": "CourseInstance", courseMode: "online", ...(credits ? { courseWorkload: credits } : {}) },
    offers: { "@type": "Offer", price: 0, priceCurrency: "INR", category: "Free" },
    url: absUrl(path),
  }]}
>
  <Crumbs items={[
    { label: "VTU", href: "/vtu" },
    { label: branch.shortName, href: `/vtu/${branch.slug}` },
    { label: semesterName(n), href: `/vtu/${branch.slug}/${Astro.params.semester}` },
    { label: subject.shortName },
  ]} />
  <Steps current={3} branch={{ label: branch.shortName, href: `/vtu/${branch.slug}` }} semester={{ label: semesterName(n), href: `/vtu/${branch.slug}/${Astro.params.semester}` }} />
  <PageHeader
    kicker={`${subject.code} · ${branch.shortName} · ${semesterName(n)} · Karnataka`}
    title={subject.name}
    answer={subject.description}
  >
    <p slot="meta" class="mt-3 flex flex-wrap gap-x-3 text-sm text-muted">
      {credits ? <span>{credits}</span> : null}
      <span>{subject.scheme} scheme</span>
      {subject.courseType ? <span>{subject.courseType}</span> : <span class="capitalize">{subject.kind}</span>}
      {subject.hasLab && subject.kind !== "lab" ? <span>includes lab</span> : null}
    </p>
  </PageHeader>
  <dl class="mb-6 grid grid-cols-2 gap-3 text-sm lg:grid-cols-4">
    <div class="rounded-md border bg-surface px-4 py-3"><dt class="text-xs font-medium uppercase tracking-wider text-faint">Course code</dt><dd class="mt-1 font-mono font-semibold">{subject.code}</dd></div>
    <div class="rounded-md border bg-surface px-4 py-3"><dt class="text-xs font-medium uppercase tracking-wider text-faint">Credits</dt><dd class="mt-1 font-semibold">{subject.credits ?? "Not printed in scheme"}</dd></div>
    <div class="rounded-md border bg-surface px-4 py-3"><dt class="text-xs font-medium uppercase tracking-wider text-faint">Programme</dt><dd class="mt-1 font-semibold"><a class="hover:text-primary" href={`/vtu/${branch.slug}`}>{branch.name}</a></dd></div>
    <div class="rounded-md border bg-surface px-4 py-3"><dt class="text-xs font-medium uppercase tracking-wider text-faint">Semester</dt><dd class="mt-1 font-semibold"><a class="hover:text-primary" href={`/vtu/${branch.slug}/${Astro.params.semester}`}>{semesterName(n)}</a></dd></div>
  </dl>
  {subject.electiveGroup ? (
    <Notice class="mb-6">
      This is one option in elective slot <strong class="text-foreground">{subject.electiveGroup}</strong>. You study one course from the slot, chosen from what your college offers.
      {slotOptions.length > 0 ? <> Other options: {slotOptions.map((s, i) => <>{i > 0 ? ", " : ""}<a class="text-primary hover:underline" href={subjectPath(s)}>{s.name}</a></>)}.</> : null}
    </Notice>
  ) : null}
  <div class="mb-4 flex flex-wrap items-center gap-3">
    <NotesPdf notes={notes} />
    <p class="max-w-xl text-sm text-muted">Every module, every textbook VTU names for {subject.code}, and a study frame for each topic. The file downloads in your browser.</p>
  </div>
  <ul class="flex flex-wrap gap-2">
    {resourceTypes.filter((t) => counts[t.slug] > 0).map((t) => (
      <li>
        <a class="inline-flex h-11 items-center rounded-md border bg-surface px-3 text-sm font-medium hover:border-primary/40" href={`${path}/${t.slug}`}>
          {t.label}<span class="ml-2 text-xs text-faint">{counts[t.slug]}</span>
        </a>
      </li>
    ))}
  </ul>
  <section class="mt-6 rounded-xl border bg-secondary/60 p-5" aria-labelledby="practice">
    <h2 id="practice" class="text-lg font-semibold">Practice for the SEE</h2>
    <p class="mt-1 text-sm text-muted">
      Work the original practice questions for {subject.name}. Official {subject.code} papers stay on vtu.ac.in — the link below is a search, not a paper hosted here.
    </p>
    <div class="mt-4 flex flex-wrap gap-2">
      {counts["question-papers"] > 0 ? (
        <a class="inline-flex h-11 items-center rounded-lg bg-primary px-4 text-sm font-semibold text-primary-foreground hover:bg-primary-hover" href={`${path}/question-papers`}>Practice questions</a>
      ) : null}
      {counts["important-questions"] > 0 ? (
        <a class="inline-flex h-11 items-center rounded-lg border bg-surface px-4 text-sm font-semibold hover:border-primary hover:text-primary" href={`${path}/important-questions`}>Important questions</a>
      ) : null}
      <a
        class="inline-flex h-11 items-center gap-1 rounded-lg border bg-surface px-4 text-sm font-semibold hover:border-primary hover:text-primary"
        href={`https://www.google.com/search?q=${encodeURIComponent(`site:vtu.ac.in ${subject.code} question paper`)}`}
        rel="nofollow noopener"
        target="_blank"
      >Search official papers on vtu.ac.in <span aria-hidden="true">↗</span></a>
    </div>
  </section>
  <Notice class="mt-6">
    Course code, title and credits are read from VTU's official scheme PDF{subject.sourceUrl ? <> (<a class="text-primary hover:underline" href={subject.sourceUrl} rel="noopener" target="_blank">open the scheme PDF on vtu.ac.in</a>)</> : null} and re-checked daily. Guides are original VTUHub writing — we do not host question-paper PDFs or scanned notes.
  </Notice>
  {studyNotes ? (
    <section class="mt-10" aria-labelledby="notes">
      <div class="flex flex-wrap items-end justify-between gap-2">
        <h2 id="notes" class="text-xl font-semibold">{subject.code} {subject.name} — notes</h2>
        <p class="text-xs text-faint">Updated {formatFullDate(studyNotes.frontmatter.updated)}</p>
      </div>
      <p class="mt-1 text-sm text-muted">
        Module-wise notes written by VTUHub against the official {subject.scheme}-scheme syllabus{studyNotes.frontmatter.textbook ? <>, following {studyNotes.frontmatter.textbook}</> : null}. Read the textbook for full proofs, figures and exercises.
      </p>
      {(subject.textbooks?.length || subject.references?.length) ? (
        <div class="mt-4 rounded-xl border bg-surface p-4">
          <p class="text-xs font-semibold uppercase tracking-wider text-primary">Prescribed by VTU for {subject.code}</p>
          {subject.textbooks?.length ? (
            <>
              <p class="mt-2 text-sm font-semibold">Textbooks</p>
              <ol class="mt-1 list-decimal space-y-1 pl-5 text-sm text-muted">{subject.textbooks.map((b) => <li>{b}</li>)}</ol>
            </>
          ) : null}
          {subject.references?.length ? (
            <>
              <p class="mt-3 text-sm font-semibold">Reference books</p>
              <ol class="mt-1 list-decimal space-y-1 pl-5 text-sm text-muted">{subject.references.map((b) => <li>{b}</li>)}</ol>
            </>
          ) : null}
        </div>
      ) : null}
      <nav class="mt-4 flex flex-wrap gap-2 text-sm" aria-label="Jump to module">
        {studyNotes.getHeadings().filter((h) => h.depth === 2).map((h) => (
          <a class="inline-flex min-h-9 items-center rounded-md border bg-surface px-3 hover:border-primary hover:text-primary" href={`#${h.slug}`}>{h.text.replace(/\s+—.*$/, "")}</a>
        ))}
      </nav>
      <article class="notes-prose mt-6">
        <studyNotes.Content />
      </article>
    </section>
  ) : null}
  {subject.units.length > 0 ? (
    <section class="mt-10" aria-labelledby="modules">
      <div class="flex flex-wrap items-end justify-between gap-2">
        <h2 id="modules" class="text-lg font-semibold">{subject.code} syllabus — {subject.units.length} modules</h2>
        {subject.syllabusUrl ? <a class="text-sm font-medium text-primary hover:underline" href={subject.syllabusUrl} rel="noopener" target="_blank">Official syllabus PDF ↗</a> : null}
        {!subject.syllabusUrl && subject.moduleSourceUrl ? <a class="text-sm font-medium text-primary hover:underline" href={subject.moduleSourceUrl} rel="noopener" target="_blank">Read from {subject.moduleSourceUrl.split("/").pop()} ↗</a> : null}
      </div>
      <ol class="mt-4 space-y-3">
        {subject.units.map((u) => (
          <li class="rounded-xl border bg-surface p-4">
            <p class="text-xs font-semibold uppercase tracking-wider text-primary">Module {u.number}</p>
            <h3 class="mt-1 font-semibold">{u.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{u.topics}</p>
          </li>
        ))}
      </ol>
      {subject.syllabusUrl ? <p class="mt-2 text-xs text-faint">Module topics as listed in VTU's official {subject.scheme}-scheme syllabus. Check the PDF for lab programs, CIE/SEE split and question-paper pattern.</p> : null}
      {!subject.syllabusUrl && subject.moduleSourceUrl ? <p class="mt-2 text-xs text-faint">These modules were read from {subject.moduleSourceUrl.split("/").pop()}. That file is not this programme’s syllabus PDF. Check the scheme PDF for {subject.code} before you rely on a title.</p> : null}
    </section>
  ) : null}
  {subject.outcomes.length > 0 ? (
    <section class="mt-10" aria-labelledby="outcomes">
      <h2 id="outcomes" class="text-lg font-semibold">Course outcomes</h2>
      <p class="mt-1 text-sm text-muted">What VTU expects you to be able to do after {subject.code} — the SEE paper is set against these.</p>
      <ol class="mt-3 list-decimal space-y-1.5 pl-5 text-muted">
        {subject.outcomes.map((o) => <li>{o}</li>)}
      </ol>
    </section>
  ) : null}
  {(subject.textbooks?.length || subject.references?.length || subject.links?.length) ? (
    <section class="mt-10" aria-labelledby="refs">
      <h2 id="refs" class="text-lg font-semibold">Books and references prescribed by VTU</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-2">
        {subject.textbooks?.length ? (
          <div class="rounded-xl border bg-surface p-4">
            <h3 class="text-sm font-semibold">Textbooks</h3>
            <ol class="mt-2 list-decimal space-y-1.5 pl-5 text-sm text-muted">{subject.textbooks.map((b) => <li>{b}</li>)}</ol>
          </div>
        ) : null}
        {subject.references?.length ? (
          <div class="rounded-xl border bg-surface p-4">
            <h3 class="text-sm font-semibold">Reference books</h3>
            <ol class="mt-2 list-decimal space-y-1.5 pl-5 text-sm text-muted">{subject.references.map((b) => <li>{b}</li>)}</ol>
          </div>
        ) : null}
        {subject.links?.length ? (
          <div class="rounded-xl border bg-surface p-4 md:col-span-2">
            <h3 class="text-sm font-semibold">Web links and video lectures (from the syllabus)</h3>
            <ul class="mt-2 space-y-1.5 text-sm">
              {subject.links.map((l) => (
                <li class="truncate"><a class="text-primary hover:underline" href={l} rel="nofollow noopener" target="_blank">{l.replace(/^https?:\/\/(www\.)?/, "")}</a></li>
              ))}
            </ul>
          </div>
        ) : null}
      </div>
    </section>
  ) : null}
  {files.length > 0 ? (
    <section class="mt-10">
      <h2 class="mb-4 text-lg font-semibold">Guides</h2>
      <FileTable files={files} />
    </section>
  ) : null}
  {alsoIn.length > 0 ? (
    <section class="mt-10">
      <h2 class="mb-1 text-lg font-semibold">Same course in other programmes</h2>
      <p class="mb-3 text-sm text-muted">{subject.code} is also part of these VTU programmes' 2022 scheme.</p>
      <ul class="flex flex-wrap gap-2 text-sm">
        {alsoIn.map(({ s, b }) => (
          <li><a class="inline-flex h-10 items-center rounded-md border bg-surface px-3 hover:border-primary hover:text-primary" href={subjectPath(s)}>{b.shortName}</a></li>
        ))}
      </ul>
    </section>
  ) : null}
  {siblings.length > 0 ? (
    <section class="mt-10">
      <h2 class="mb-3 text-lg font-semibold">Same semester</h2>
      <ul class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
        {siblings.map((s) => <li><a class="text-primary hover:underline" href={subjectPath(s)}>{s.name}</a></li>)}
      </ul>
    </section>
  ) : null}
</Base>
