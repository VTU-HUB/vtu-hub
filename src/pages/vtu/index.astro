---
import Base from "@/layouts/Base.astro";
import Steps from "@/components/site/Steps.astro";
import Browse from "@/components/site/Browse.astro";
import Crumbs from "@/components/site/Crumbs.astro";
import PageHeader from "@/components/site/PageHeader.astro";
import { schemes } from "@/data/branches";
---

<Base
  title="VTU Notes & Syllabus by Branch and Semester"
  description="All VTU 2022-scheme B.E./B.Tech programmes by stream — CSE, ISE, AIML, Data Science, ECE, EEE, Mechanical, Civil and more — with semester-wise subjects, credits and official syllabus."
  path="/vtu"
  crumbs={[{ label: "VTU", href: "/vtu" }]}
>
  <Crumbs items={[{ label: "VTU" }]} />
  <Steps current={1} />
  <PageHeader
    title="Browse VTU resources"
    answer="Open a semester to see every VTU branch in Karnataka, or pick your programme below — grouped by first-year stream — for its subject codes, credits and syllabus. Nothing on this page defaults to Computer Science."
    description="Open a semester to see every branch, or pick a programme for subject codes. Semesters do not default to CSE."
  />
  <Browse kind="jump" />
  <section class="mt-8">
    <h2 class="mb-4 text-lg font-semibold">Semesters</h2>
    <p class="mb-4 max-w-2xl text-sm text-muted">Each semester lists every programme that runs that term. It does not open Computer Science automatically.</p>
    <Browse kind="semesters" />
  </section>
  <section class="mt-14">
    <h2 class="mb-4 text-lg font-semibold">Branches</h2>
    <Browse kind="branches" />
  </section>
  <section class="mt-14">
    <div class="mb-4 flex items-end justify-between"><h2 class="text-lg font-semibold">Schemes</h2><a class="text-sm font-medium text-primary hover:underline" href="/schemes">All schemes</a></div>
    <ul class="grid gap-3 md:grid-cols-3">
      {schemes.map((s) => (
        <li>
          <a class="block h-full rounded-lg border bg-surface p-4 hover:border-primary/40" href={`/schemes/${s.year}`}>
            <p class="text-xs font-medium uppercase tracking-wider text-muted">{s.year}</p>
            <h3 class="mt-1 font-semibold">{s.name}</h3>
            <p class="mt-2 text-sm text-muted">{s.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
