---
import Base from "@/layouts/Base.astro";
import Crumbs from "@/components/site/Crumbs.astro";
import PageHeader from "@/components/site/PageHeader.astro";
import { GRADE_SCALE, tools } from "@/data/tools";
import { absUrl, SITE_URL } from "@/lib/site";

export function getStaticPaths() {
  return tools.map((t) => ({ params: { slug: t.slug } }));
}

const tool = tools.find((t) => t.slug === Astro.params.slug)!;
const answers: Record<string, string> = {
  sgpa: "SGPA = Σ (credits × grade points) / Σ credits for that semester. Failed papers stay in the denominator until you clear them. The 10-point scale runs from O (10) to F (0).",
  cgpa: "CGPA = Σ (semester credits × SGPA) / Σ semester credits. An informal percentage is (CGPA − 0.75) × 10. That conversion is not an official transcript.",
  marks: "Add CIE and SEE, cap the total at 100, then map it to the VTU letter grade. A common pass line is 40. Use 50+50 for the 2022 scheme and 40+60 for 2018.",
  attendance: "Attendance % = classes attended / classes conducted. Many VTU colleges use 85% up to the last working day. If your college notice is stricter, follow that.",
  percentage: "Percentage = obtained ÷ maximum × 100. Reverse a percentage by multiplying it by the maximum marks.",
};
---
<Base
  title={tool.name}
  description={tool.description}
  path={tool.href}
  crumbs={[{ label: "Tools", href: "/tools" }, { label: tool.name, href: tool.href }]}
  faqs={[{ q: `How does the VTU ${tool.name} work?`, a: answers[tool.slug] }]}
  extraJsonLd={[{
    "@type": "SoftwareApplication",
    name: tool.name,
    description: tool.description,
    applicationCategory: "EducationalApplication",
    operatingSystem: "Web",
    offers: { "@type": "Offer", price: "0", priceCurrency: "INR" },
    url: absUrl(tool.href),
    provider: { "@id": `${SITE_URL}/#organization` },
  }]}
>
  <Crumbs items={[{ label: "Tools", href: "/tools" }, { label: tool.name }]} />
  <PageHeader title={tool.name} answer={answers[tool.slug]} description={tool.description} />
  <div data-calc={tool.slug} class="min-h-40">
    <p class="text-sm text-muted">The calculator loads in your browser. Nothing is sent to VTUHub.</p>
  </div>
  {tool.slug === "sgpa" || tool.slug === "marks" ? (
    <table class="mt-8 w-full max-w-xl border-collapse text-sm">
      <caption class="mb-2 text-left text-xs font-medium uppercase tracking-wider text-faint">VTU 10-point scale</caption>
      <thead><tr class="border-b text-left text-xs uppercase tracking-wider text-faint"><th class="py-2">Grade</th><th>Meaning</th><th>From</th><th>Points</th></tr></thead>
      <tbody>
        {GRADE_SCALE.map((g) => (
          <tr class="border-b"><td class="py-2 font-medium">{g.letter}</td><td class="text-muted">{g.label}</td><td class="text-muted">{g.min}</td><td class="text-muted">{g.point}</td></tr>
        ))}
      </tbody>
    </table>
  ) : null}
  <aside class="mt-10 rounded-md border bg-secondary px-4 py-3 text-sm text-muted">These calculators run in your browser. VTUHub does not store USNs, marks or attendance.</aside>
  <ul class="mt-8 flex flex-wrap gap-3 text-sm">
    {tools.filter((t) => t.slug !== tool.slug).map((t) => (
      <li><a class="text-primary hover:underline" href={t.href}>{t.name}</a></li>
    ))}
  </ul>
  <script>
    import { mountCalculators } from "@/scripts/calculators.ts";
    mountCalculators();
  </script>
</Base>
